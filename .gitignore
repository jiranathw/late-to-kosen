# Unity generated folders — safe to ignore, Unity regenerates them
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Visual Studio / Rider cache
.vs/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db

# Unity crash logs
sysinfo.txt
*.stackdump
editor_log.txt
editor_log_prev.txt

# Scene backups Unity dumps here after a crash — never commit these
/Assets/_Recovery/
/Assets/_Recovery.meta

# Packages lock (keep this one tracked instead — only ignore if it causes issues)
# /[Pp]ackages/packages-lock.json

# Python bytecode from the Tools/ scene generators
__pycache__/
*.pyc
